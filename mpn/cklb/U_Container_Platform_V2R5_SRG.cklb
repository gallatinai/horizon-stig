        {
          "group_id_src": "V-233055",
          "group_tree": [
            {
              "id": "V-233055",
              "title": "SRG-APP-000116",
              "description": "<GroupDescription></GroupDescription>"
            }
          ],
          "group_id": "V-233055",
          "severity": "medium",
          "group_title": "SRG-APP-000116",
          "rule_id_src": "SV-233055r960927_rule",
          "rule_id": "SV-233055r960927",
          "rule_version": "SRG-APP-000116-CTR-000235",
          "rule_title": "The container platform must use internal system clocks to generate audit record time stamps.",
          "fix_text": "Configure the container platform to use internal system clocks to generate time stamps for log records.",
          "weight": "10.0",
          "check_content": "Review the container platform configuration files to determine if the internal system clock is used for time stamps. \n\nIf the container platform does not use the internal system clock to generate time stamps, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Understanding when and sequence of events for an incident is crucial to understand what may have taken place. Without a common clock, the components generating audit events could be out of synchronization and would then present a picture of the event that is warped and corrupted. To give a clear picture, it is important that the container platform and its components use a common internal clock.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
