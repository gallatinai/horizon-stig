          "group_title": "SRG-APP-000705",
          "rule_id_src": "SV-263586r982453_rule",
          "rule_id": "SV-263586r982453",
          "rule_version": "SRG-APP-000705-CTR-000110",
          "rule_title": "The container platform must disable accounts when the accounts are no longer associated to a user.",
          "fix_text": "Configure the container platform to disable accounts when the accounts are no longer associated to a user.",
          "weight": "10.0",
          "check_content": "Verify the container platform is configured to disable accounts when the accounts are no longer associated to a user.\n\nIf the container platform is not configured to disable accounts when the accounts are no longer associated to a user, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Disabling expired, inactive, or otherwise anomalous accounts supports the concepts of least privilege and least functionality which reduce the attack surface of the system.",
