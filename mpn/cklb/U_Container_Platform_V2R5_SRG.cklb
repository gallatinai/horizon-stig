          "group_id": "V-233260",
          "severity": "medium",
          "group_title": "SRG-APP-000500",
          "rule_id_src": "SV-233260r961815_rule",
          "rule_id": "SV-233260r961815",
          "rule_version": "SRG-APP-000500-CTR-001260",
          "rule_title": "The container platform must generate audit records when successful/unsuccessful attempts to delete security levels occur.",
          "fix_text": "Configure the container platform to generate audit records when successful/unsuccessful attempts to delete security levels.",
          "weight": "10.0",
          "check_content": "Review the container platform configuration to verify audit records are generated on successful/unsuccessful attempts to delete security levels. \n\nIf audit records are not generated, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "The container platform and its components must generate audit records when deleting security levels. All the components must use the same standard so that the events can be tied together to understand what took place within the overall container platform. This must establish, correlate, and help assist with investigating the events relating to an incident, or identify those responsible.\n\nWithout audit record generation, unauthorized users can delete security levels unknowingly for malicious intent creating vulnerabilities within the container platform.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
