        {
          "group_id_src": "V-263587",
          "group_tree": [
            {
              "id": "V-263587",
              "title": "SRG-APP-000745",
              "description": "<GroupDescription></GroupDescription>"
            }
          ],
          "group_id": "V-263587",
          "severity": "medium",
          "group_title": "SRG-APP-000745",
          "rule_id_src": "SV-263587r982455_rule",
          "rule_id": "SV-263587r982455",
          "rule_version": "SRG-APP-000745-CTR-000120",
          "rule_title": "The container platform must implement the capability to centrally review and analyze audit records from multiple components within the system.",
          "fix_text": "Configure the container platform to implement the capability to centrally review and analyze audit records from multiple components within the system.",
          "weight": "10.0",
          "check_content": "Verify the container platform is configured to implement the capability to centrally review and analyze audit records from multiple components within the system.\n\nIf the container platform is not configured to implement the capability to centrally review and analyze audit records from multiple components within the system, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Automated mechanisms for centralized reviews and analyses include Security Information and Event Management products.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
          "third_party_tools": "",
