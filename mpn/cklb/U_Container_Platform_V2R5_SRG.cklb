          "rule_version": "SRG-APP-000508-CTR-001300",
          "rule_title": "Direct access to the container platform must generate audit records.",
          "fix_text": "Configure the container platform to generate audit records when accessed directly.",
          "weight": "10.0",
          "check_content": "Review the container platform configuration to determine if direct access of the container platform generates audit records. \n\nIf audit records are not generated, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
