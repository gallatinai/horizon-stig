          ],
          "group_id": "V-263598",
          "severity": "medium",
          "group_title": "SRG-APP-000880",
          "rule_id_src": "SV-263598r982471_rule",
          "rule_id": "SV-263598r982471",
          "rule_version": "SRG-APP-000880-CTR-000290",
          "rule_title": "The container platform must protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.",
          "fix_text": "Configure the container platform to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.",
          "weight": "10.0",
          "check_content": "Verify the container platform is configured to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.\n\nIf the container platform is not configured to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Nonlocal maintenance and diagnostic activities are conducted by individuals who communicate through either an external or internal network.\nCommunications paths can be logically separated using encryption.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "ia_controls": "",
