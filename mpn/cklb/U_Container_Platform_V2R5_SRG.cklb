            }
          ],
          "group_id": "V-233086",
          "severity": "medium",
          "group_title": "SRG-APP-000158",
          "rule_id_src": "SV-233086r960999_rule",
          "rule_id": "SV-233086r960999",
          "rule_version": "SRG-APP-000158-CTR-000390",
          "rule_title": "The container platform must uniquely identify all network-connected nodes before establishing any connection.",
          "fix_text": "Configure the container platform to uniquely identify all nodes before establishing the connection.",
          "weight": "10.0",
          "check_content": "Review the container platform configuration to determine if the container platform uniquely identifies all nodes before establishing a connection. \n\nIf the container platform is not configured to uniquely identify all nodes before establishing the connection, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "A container platform usually consists of multiple nodes. It is important for these nodes to be uniquely identified before a connection is allowed. Without identifying the nodes, unidentified or unknown nodes may be introduced, thereby facilitating malicious activity.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "ia_controls": "",
