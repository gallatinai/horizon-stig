          "group_id": "V-233230",
          "severity": "medium",
          "group_title": "SRG-APP-000454",
          "rule_id_src": "SV-233230r961677_rule",
          "rule_id": "SV-233230r961677",
          "rule_version": "SRG-APP-000454-CTR-001110",
          "rule_title": "The container platform must remove old components after updated versions have been installed.",
          "fix_text": "Configure the container platform registry to update organization-defined images with current approved vendor version and remove obsolete images after updated versions have been installed. Configure the container platform runtime to execute latest organization-defined images from the container platform registry.",
          "weight": "10.0",
          "check_content": "Review container platform registry documentation and configuration to determine if organization-defined images contains latest approved vendor software image version. \n\nIf organization-defined images do not contain the latest approved vendor software image version, this is a finding. \n\nReview container platform registry documentation and configuration to determine if organization-defined images are removed after updated versions have been installed. \n\nIf organization-defined images are not removed after updated versions have been installed, this is a finding. \n\nReview container platform runtime documentation and configuration to determine if organization-define images are executing latest image version from the container platform registry. \n\nIf container platform runtime is not executing latest organization-defined images from the container platform registry, this is a finding.",
          "check_content_ref": {
            "href": "Container_Platform__SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Previous versions of container platform components that are not removed from the container platform after updates have been installed may be exploited by adversaries by causing older components to execute which contain vulnerabilities. When these components are deleted, the likelihood of this happening is removed.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "ia_controls": "",
          "responsibility": "",
          "mitigations": "",
          "mitigation_control": "",
          "legacy_ids": [],
