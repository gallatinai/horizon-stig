          "rule_version": "SRG-APP-000100-AAA-000270",
          "rule_title": "AAA Services configuration audit records must identify any individual user or process associated with the event.",
          "fix_text": "Configure AAA Services configuration audit records to identify any individual user associated with the event. When events are caused by a system process rather than an individual user, that process must be identified in the audit record.",
          "weight": "10.0",
          "check_content": "Verify AAA Services configuration audit records identify any individual user associated with the event. When a system process rather than an individual user causes the event, the process must be identified in the audit record.\n\nIf AAA Services configuration audit records do not identify any individual user or process associated with the event, this is a finding.",
          "check_content_ref": {
            "href": "AAA_Services_SRG.xml",
            "name": "M"
