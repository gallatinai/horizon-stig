          "rule_version": "SRG-APP-000028-AAA-000110",
          "rule_title": "AAA Services must be configured to automatically audit account disabling actions.",
          "fix_text": "Configure AAA Services to automatically audit account disabling actions.",
          "weight": "10.0",
