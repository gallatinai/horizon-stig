          "rule_id_src": "SV-242459r961863_rule",
          "rule_id": "SV-242459r961863",
          "rule_version": "CNTR-K8-003260",
          "rule_title": "The Kubernetes etcd must have file permissions set to 644 or more restrictive.",
          "fix_text": "Change the permissions of the manifest files to \"644\" by executing the command:\n\nchmod -R 644 /var/lib/etcd/*",
          "weight": "10.0",
          "check_content": "Review the permissions of the Kubernetes etcd by using the command:\n\nls -AR /var/lib/etcd/*\n\nIf any of the files have permissions more permissive than \"644\", this is a finding.",
          "check_content_ref": {
            "href": "Kubernetes_STIG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "The Kubernetes etcd key-value store provides a way to store data to the Control Plane. If these files can be changed, data to API object and Control Plane would be compromised.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
