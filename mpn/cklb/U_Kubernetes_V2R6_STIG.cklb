          "group_id": "V-242409",
          "severity": "medium",
          "group_title": "SRG-APP-000141-CTR-000315",
          "rule_id_src": "SV-242409r960963_rule",
          "rule_id": "SV-242409r960963",
          "rule_version": "CNTR-K8-000910",
          "rule_title": "Kubernetes Controller Manager must disable profiling.",
          "fix_text": "Edit the Kubernetes Controller Manager manifest file in the /etc/kubernetes/manifests directory on the Kubernetes Control Plane. Set the argument \"--profiling value\" to \"false\".",
          "weight": "10.0",
          "check_content": "Change to the /etc/kubernetes/manifests/ directory on the Kubernetes Control Plane. Run the command:\ngrep -i profiling * \n\nIf the setting \"profiling\" is not configured in the Kubernetes Controller Manager manifest file or it is set to \"True\", this is a finding.",
          "check_content_ref": {
            "href": "Kubernetes_STIG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Kubernetes profiling provides the ability to analyze and troubleshoot Controller Manager events over a web interface on a host port. Enabling this service can expose details about the Kubernetes architecture. This service must not be enabled unless deemed necessary.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
          "third_party_tools": "",
          "ia_controls": "",
          "responsibility": "",
          "mitigations": "",
          "mitigation_control": "",
          "legacy_ids": [],
