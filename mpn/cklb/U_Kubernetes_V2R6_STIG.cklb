          "ccis": [
            "CCI-001184"
          ],
          "reference_identifier": "5376",
          "uuid": "84536966-e4dc-58f0-b58d-28b6310ddee8",
          "stig_uuid": "92b6f33f-228f-5363-afb6-9f95dc57a4b5",
          "status": "not_reviewed",
          "overrides": {},
