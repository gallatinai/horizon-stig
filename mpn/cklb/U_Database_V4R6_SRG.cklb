          "rule_id_src": "SV-263618r982503_rule",
          "rule_id": "SV-263618r982503",
          "rule_version": "SRG-APP-000880-DB-000290",
          "rule_title": "The DBMS must protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.",
          "fix_text": "Configure the DBMS to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.",
          "weight": "10.0",
          "check_content": "Verify the DBMS is configured to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths.\n\nIf the DBMS is not configured to protect nonlocal maintenance sessions by separating the maintenance session from other network sessions with the system by logically separated communications paths, this is a finding.",
          "check_content_ref": {
            "href": "Database_Generic_SRG.xml",
            "name": "M"
