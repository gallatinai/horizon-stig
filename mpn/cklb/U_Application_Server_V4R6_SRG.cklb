          "rule_id_src": "SV-278963r1227259_rule",
          "rule_id": "SV-278963r1227259",
          "rule_version": "SRG-APP-001050-AS-000326",
          "rule_title": "The application server must attach data tags containing organization-defined processing purposes to organization-defined elements of personally identifiable information.",
          "fix_text": "Configure the application server to attach data tags containing organization-defined processing purposes to organization-defined elements of personally identifiable information.",
          "weight": "10.0",
          "check_content": "Verify the application server is configured to attach data tags containing organization-defined processing purposes to organization-defined elements of personally identifiable information.\n\nIf the application server does not attach data tags containing organization-defined processing purposes to organization-defined elements of personally identifiable information, this is a finding.",
          "check_content_ref": {
            "href": "Application_Server_SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Data tags support the tracking of processing purposes by conveying the purposes along with the relevant elements of personally identifiable information throughout the system. By conveying the processing purposes in a data tag along with the personally identifiable information as the information transits a system, a system owner or operator can identify whether a change in processing would be compatible with the identified and documented purposes. Data tags may also support the use of automated tools. \n\nThis requirement also applies to Zero Trust initiatives.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
          "third_party_tools": "",
