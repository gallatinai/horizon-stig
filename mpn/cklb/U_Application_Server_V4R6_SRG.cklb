            }
          ],
          "group_id": "V-204804",
          "severity": "medium",
          "group_title": "SRG-APP-000400",
          "rule_id_src": "SV-204804r961521_rule",
          "rule_id": "SV-204804r961521",
          "rule_version": "SRG-APP-000400-AS-000246",
          "rule_title": "The application server must prohibit the use of cached authenticators after an organization-defined time period.",
          "fix_text": "Configure the application server to prohibit the use of cached authenticators after an organization-defined timeframe.",
          "weight": "10.0",
          "check_content": "Review application server documentation to ensure the application server prohibits the use of cached authenticators after an organization-defined timeframe.\n\nIf the application server is not configured to meet this requirement, this is a finding.",
          "check_content_ref": {
            "href": "Application_Server_SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "When the application server is using PKI authentication, a local revocation cache must be stored for instances when the revocation cannot be authenticated through the network, but if cached authentication information is out of date, the validity of the authentication information may be questionable.",
