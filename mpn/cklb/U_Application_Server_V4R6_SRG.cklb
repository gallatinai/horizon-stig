          ],
          "group_id": "V-278967",
          "severity": "high",
          "group_title": "SRG-APP-001035",
          "rule_id_src": "SV-278967r1137615_rule",
          "rule_id": "SV-278967r1137615",
          "rule_version": "SRG-APP-001035-AS-000323",
          "rule_title": "The application server must be a version supported by the vendor.",
          "fix_text": "Install a version of the application server supported by the vendor.",
          "weight": "10.0",
          "check_content": "Verify the application is a version supported by the vendor.\n\nIf the application server is not a version supported by the vendor, this is a finding.",
          "check_content_ref": {
            "href": "Application_Server_SRG.xml",
            "name": "M"
          },
          "classification": "Unclassified",
          "discussion": "Unsupported software and systems should not be used because fixes to newly identified bugs will not be implemented by the vendor. The lack of support can result in potential vulnerabilities.\n\nSoftware and systems at unsupported servicing levels or releases will not receive security updates for new vulnerabilities, which leaves them subject to exploitation.\n\nWhen maintenance updates and patches are no longer available, software is no longer considered supported and should be upgraded or decommissioned.",
          "false_positives": "",
          "false_negatives": "",
          "documentable": "false",
          "security_override_guidance": "",
          "potential_impacts": "",
          "third_party_tools": "",
