  "stigs": [
    {
      "stig_name": "Application Server Security Requirements Guide",
      "display_name": "Application Server Security Requirements Guide",
      "stig_id": "Application_Server_SRG",
      "version": "4",
      "release_info": "Release: 6 Benchmark Date: 30 Sep 2026",
      "uuid": "3817652a-d733-5ebb-b7dc-03a0b4466071",
