          "rule_id": "SV-204785r961362",
          "rule_version": "SRG-APP-000343-AS-000030",
          "rule_title": "The application server must provide access logging that ensures users who are granted a privileged role (or roles) have their privileged activity logged.",
          "fix_text": "Configure the application server to log privileged activity.",
          "weight": "10.0",
          "check_content": "Review application server documentation and log configuration to verify the application server logs privileged activity.\n\nIf the application server is not configured to log privileged activity, this is a finding.",
          "check_content_ref": {
